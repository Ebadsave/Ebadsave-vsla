{
  "expo": {
    "name": "Ebadsave VSLA",
    "slug": "ebadsave-vsla",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon/app_icon.png",
    "userInterfaceStyle": "light",

    "android": {
      "package": "com.ebadsave.vsla",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/app_icon.png",
        "backgroundColor": "#FFFFFF"
      },

      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION"
      ]
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],

    "scheme": "ebadsavevsla"
  }
}
