    "userInterfaceStyle": "light",
    "android": {
      "package": "com.ebadsave.vsla",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/app_icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.SEND_SMS"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a"
            ]
          }
        }
      ]
    ],
    "scheme": "ebadsavevsla"
  }
  }
